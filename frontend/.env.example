# Frontend build settings. Vite bakes these into the bundle at build time, so they are public:
# never put a secret here. Server secrets live in backend/.env.

# Stripe publishable key (pk_test_... or pk_live_...). Must belong to the same Stripe account
# as the backend's STRIPE_SECRET_KEY.
VITE_STRIPE_PUBLISHABLE_KEY=

# Where the API is, if not on the same origin as the site. Leave unset when Nginx serves
# both (production) or the Vite dev proxy forwards /api (local).
# VITE_API_URL=https://your-domain.com
